FROM debian:stable

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-pip \
        imagemagick \
        git \
        build-essential \
        pkg-config \
        libfreetype6-dev \
        libpng-dev \
        zlib1g-dev \
        ca-certificates \
        curl \
        sudo \
    && useradd --create-home --shell /bin/bash builder \
    && echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers \
    && mkdir -p /opt/distrofonts /output \
    && chown builder:builder /opt/distrofonts /output \
    && curl -fsSL https://www.tdb.fi/files/ttf2png-2.0.tar.gz -o /tmp/ttf2png.tar.gz \
    && tar -xzf /tmp/ttf2png.tar.gz -C /tmp \
    && sed -i 's/-Werror //; s/-std=c89 -pedantic/-std=gnu99/' /tmp/ttf2png-2.0/Makefile \
    && make -C /tmp/ttf2png-2.0 \
    && install -m 0755 /tmp/ttf2png-2.0/ttf2png /usr/local/bin/ttf2png \
    && rm -rf /tmp/ttf2png.tar.gz /tmp/ttf2png-2.0

COPY --chown=builder:builder . /opt/distrofonts
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir /opt/distrofonts

USER builder
WORKDIR /opt/distrofonts
ENV PATH="/opt/venv/bin:${PATH}"
ENTRYPOINT ["distrofonts"]
CMD ["generate", "--help"]
